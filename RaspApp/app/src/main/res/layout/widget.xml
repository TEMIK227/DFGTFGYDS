<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_tag" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:textColor="#7AA2F7" />
    <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="26sp" android:textStyle="bold" android:maxLines="1" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/w_place" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:maxLines="1" android:textColor="#AEB4D0" />
    <TextView android:id="@+id/w_hw" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:maxLines="2" android:textColor="#F9E2AF" />
    <TextView android:id="@+id/w_after" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="11sp" android:maxLines="2" android:textColor="#89DCEB" />
    <TextView android:id="@+id/w_todos" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="11sp" android:maxLines="3" android:textColor="#A6E3A1" />
</LinearLayout>
